# fand main configuration. Installed to /etc/fand/config.yaml.
# Zone definitions (which PWM channels exist, what they cool) live separately
# at /etc/fand/zones.yaml — generated by `fand-calibrate`, then operator-edited.

# How often to read sensors, decide PWMs, and ping the systemd watchdog.
poll_interval_s: 2.0

# Equilibrium-sample window for learning. Samples are kept only when the
# system has been stable (low dT/dt and low feature variance) over this window.
equilibrium_window_s: 30.0

# Re-fit the ridge regression every N seconds from the rolling equilibrium pool.
fit_interval_s: 3600.0

# Ridge regularization. Higher = smoother, more biased. Sane range: 0.1 – 10.
ridge_lambda: 1.0

# Hysteresis between bootstrap curves and the learned model:
#   require at least N equilibrium samples AND R² ≥ min_r2 before switching.
min_samples_to_learn: 200
min_r2_to_learn: 0.7

# Safety headroom below the temp target when solving for PWM.
margin_c: 5.0

# Predictive feed-forward: exponential moving average of feature vector.
# Smaller alpha = longer memory. Default 0.05 ≈ 40 s window at 2 s poll.
ff_alpha: 0.05

# NUT UPS section name (matches /etc/nut/ups.conf).
ups_name: cyberpower

# Optional ntfy command — daemon calls `<command> '<message>'` on alarms.
# Leave commented to disable phone push; alarms still go to journald.
# ntfy_command: /path/to/your/ntfy.sh

# Persist every poll to /var/lib/fand/history.jsonl (gzip-rotated daily,
# 30-day retention). Disable to save ~50 MB/day.
history_enabled: true
