# fand main configuration. Installed to /etc/fand/config.yaml.
# Sensor catalog and fan definitions live separately at /etc/fand/zones.yaml —
# generated by `fand-calibrate`, then operator-reviewed. See DESIGN.md for
# the project's goal and the control law these tunables affect.

# Super-I/O chip name as it appears in /sys/class/hwmon/*/name. Default
# 'nct6799' matches the original target host; change for boards using a
# different nct chip (e.g. nct6798, nct6797) or another Super-I/O entirely.
chip_name: nct6799

# How often to read sensors, decide PWMs, and ping the systemd watchdog.
poll_interval_s: 2.0

# Equilibrium-sample window length. Per-fan equilibrium fires only when the
# window covers at least this many seconds of stable conditions.
equilibrium_window_s: 30.0

# How long a fan's PWM must be unchanged before its equilibrium can fire. Stops
# us recording samples mid-transient when load just settled but the daemon
# hasn't yet stopped adjusting PWM.
equilibrium_pwm_stable_s: 30.0

# Equilibrium-detector tolerances. A window is an equilibrium only when, across
# it: the fan's PWM jitter stays within pwm_jitter_tolerance counts; every
# cooled sensor's |dT/dt| stays under temp_slope_threshold (°C/s); and every
# load feature is stable. A feature counts as stable if its coefficient of
# variation (std/mean) is under feature_cov_threshold OR its raw std is under
# feature_abs_tolerance — the absolute fallback keeps inherently jittery, low-
# magnitude signals (e.g. idle CPU util) from blocking every window. Loosen the
# cov/abs tolerances if equilibria accrue too slowly; tighten if the learned
# fits look noisy.
pwm_jitter_tolerance: 4
temp_slope_threshold: 0.05
feature_cov_threshold: 0.10
feature_abs_tolerance: 2.0

# Re-fit per-sensor ridge regressions every N seconds from the rolling
# equilibrium pool.
fit_interval_s: 3600.0

# Minimum PWM range (counts) a fan must cover across the equilibrium pool for
# its cooling coefficient γ to be fit from data. A fan that never moved gives
# the regression nothing to identify γ from (its constant column is collinear
# with the intercept), so below this spread the fan keeps its calibration seed
# weight regardless of sample count.
min_pwm_spread: 10.0

# Minimum relative variation (std / mean) a load feature must show across the
# equilibrium pool for its α coefficient to be fit. A feature pinned at one
# value (GPU util sitting at 99% through a long training run) is collinear
# with the intercept and its fitted coefficient explodes on tiny noise; below
# this threshold the feature's constant contribution folds into the baseline
# instead. Columns re-enter automatically once the pool spans load regimes.
min_feature_cov: 0.05

# Ridge regularization. Higher = smoother, more biased. Sane range: 0.1 – 10.
ridge_lambda: 1.0

# Per-sensor learning gates:
#   trained ↔ n_samples ≥ min_samples_to_learn AND holdout RMSE ≤ max_rmse_to_learn_c
# While untrained, relevance weights come from each fan's cools: seed values
# (phase 3 ΔT) rather than learned γ.
# The gate is RMSE ("predicts held-out temps within X °C"), not R²: equilibrium
# samples are steady-state by construction, so the holdout window is near-flat
# and R² = 1 − ss_res/ss_tot explodes on °C-scale offsets no matter how good
# the model is. R² is still computed and shown as a diagnostic.
# (min_r2_to_learn is deprecated and ignored.)
min_samples_to_learn: 200
max_rmse_to_learn_c: 1.5

# Sample count at which γ coefficients are fully data-driven. Below this, γ
# is blended with the seed weights from zones.yaml (linear toward learned as
# n_samples / fully_trained_n).
fully_trained_n: 500

# Predictive feed-forward: per-sensor EMA of feature vector. Smaller alpha =
# longer memory. Default 0.05 ≈ 40 s window at 2 s poll. FF is disabled
# per-sensor while that sensor's α coefs are untrained.
ff_alpha: 0.05

# NUT UPS section name (matches /etc/nut/ups.conf).
ups_name: cyberpower

# Optional ntfy command — daemon calls `<command> '<message>'` on alarms.
# Leave commented to disable phone push; alarms still go to journald.
# ntfy_command: /path/to/your/ntfy.sh

# Persist every poll to /var/lib/fand/history.jsonl (gzip-rotated daily,
# 30-day retention). Disable to save ~50 MB/day.
history_enabled: true
